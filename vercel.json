{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash scripts/assemble_vercel.sh",
  "outputDirectory": ".vercel-out",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": "{preview/release/**,src/skills_vector/**,research/role-atlas/m4/roles/*.json,research/role-atlas/m5/ledger.json,research/role-atlas/2026-Q4-union/roles/*.json,research/role-atlas/2026-Q4-union/ledger.json,research/role-atlas/2026-Q4-union/views/*.json,research/role-atlas/2026-Q4-union/release.json}",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/v1", "destination": "/api/index" },
    { "source": "/v1/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/release/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    },
    {
      "source": "/release/current.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/release/releases/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/release/citations/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
