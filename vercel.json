{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "bash scripts/assemble_vercel.sh",
  "outputDirectory": ".vercel-out",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/release/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    }
  ]
}
